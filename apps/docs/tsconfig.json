{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    // Mirror the Vite aliases: the docs typecheck against the library source, not dist.
    "paths": {
      "@mah-works/larch": ["../../packages/ui/src/index.ts"],
      "@mah-works/larch/ai": ["../../packages/ui/src/ai/index.ts"],
      "@mah-works/larch/ai/*": ["../../packages/ui/src/ai/*"],
      "@mah-works/larch/*": ["../../packages/ui/src/base-ui/*"]
    }
  },
  "include": ["src"]
}
