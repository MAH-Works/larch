{
  "name": "larch",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @larch/docs dev",
    "build": "pnpm --filter @mah-works/larch build && pnpm --filter @larch/docs build",
    "build:ui": "pnpm --filter @mah-works/larch build",
    "build:docs": "pnpm --filter @larch/docs build",
    "preview": "pnpm --filter @larch/docs preview",
    "typecheck": "pnpm -r typecheck"
  },
  "packageManager": "pnpm@12.15.0"
}
